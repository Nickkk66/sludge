{
  "name": "sludge",
  "productName": "Sludge",
  "version": "1.8.0",
  "description": "Offline PDF reader that reads to you, takes your notes, answers questions locally \u2014 and plays brainrot in the background.",
  "main": "src/main/main.js",
  "author": "Nickkk66",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/vendor-pdfjs.js",
    "vendor": "node scripts/vendor-pdfjs.js",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nickkk66.sludge",
    "productName": "Sludge",
    "files": [
      "src/**/*",
      "vendor/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns"
    }
  }
}
